# Party access code shown on /login (default 5075)
ACCESS_CODE=5075

# PartyKit multiplayer host (no https://, no trailing slash)
# Required on Vercel — deploy with: npm run deploy:party
# Example: consequences.your-username.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=
PARTYKIT_HOST=

# Image generation
OPENAI_API_KEY=
FAL_KEY=
