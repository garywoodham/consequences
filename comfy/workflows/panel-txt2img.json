{
  "1": {
    "inputs": {
      "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint — replace with your Flux or SDXL NSFW checkpoint filename"
    }
  },
  "2": {
    "inputs": {
      "text": "__PROMPT__",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive prompt (injected by Consequences)"
    }
  },
  "3": {
    "inputs": {
      "text": "text, watermark, blurry, low quality, deformed",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "4": {
    "inputs": {
      "width": 768,
      "height": 768,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage"
  },
  "5": {
    "inputs": {
      "seed": 0,
      "steps": 14,
      "cfg": 5.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Sampler — seed is overridden per panel when provided"
    }
  },
  "6": {
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode"
  },
  "7": {
    "inputs": {
      "filename_prefix": "consequences_panel",
      "images": ["6", 0]
    },
    "class_type": "SaveImage"
  }
}
